@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://example.org/plugins/fft-freeze>
  a lv2:Plugin , lv2:UtilityPlugin ;
  doap:name "FFT Freeze" ;
  rdfs:label "FFT Freeze (squelette)" ;
  lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
  lv2:optionalFeature lv2:hardRTCapable ;
  lv2:port [
    a lv2:InputPort , lv2:AudioPort ;
    lv2:index 0 ;
    lv2:symbol "in_l" ;
    lv2:name "In L"
  ] , [
    a lv2:OutputPort , lv2:AudioPort ;
    lv2:index 1 ;
    lv2:symbol "out_l" ;
    lv2:name "Out L"
  ] , [
    a lv2:InputPort , atom:AtomPort ;
    atom:bufferType atom:Sequence ;
    atom:supports midi:MidiEvent ;
    lv2:index 2 ;
    lv2:symbol "midi_in" ;
    lv2:name "MIDI In"
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 3 ;
    lv2:symbol "freeze_on_note" ;
    lv2:name "Freeze on Note" ;
    lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 4 ;
    lv2:symbol "fft_size" ;
    lv2:name "FFT Size" ;
    units:unit units:frame ;
    lv2:default 1024 ; lv2:minimum 256 ; lv2:maximum 8192
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 5 ;
    lv2:symbol "spectral_mode" ;
    lv2:name "Spectral Mode" ;
    lv2:portProperty lv2:toggled ;
    lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 6 ;
    lv2:symbol "freeze_cc_number" ;
    lv2:name "Freeze CC Number" ;
    lv2:default 20 ;
    lv2:minimum 0 ;
    lv2:maximum 127
  ] .
