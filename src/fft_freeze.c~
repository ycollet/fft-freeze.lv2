// Squelette d'un plugin LV2 "FFT Freeze" — C + FFTW3
// URI du plugin : https://example.org/plugins/fft-freeze

#include <math.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include <fftw3.h>

#include "lv2/core/lv2.h"
#include "lv2/urid/urid.h"
#include "lv2/atom/atom.h"
#include "lv2/atom/util.h"
#include "lv2/midi/midi.h"

#define FFT_FREEZE_URI "https://example.org/plugins/fft-freeze"
#define FREEZE_CC_NUMBER 20 // Exemple : CC20 déclenche le gel

// Ports
typedef enum {
  PORT_IN_L = 0,
  PORT_OUT_L = 1,
  PORT_MIDI_IN = 2,
  PORT_FREEZE_ON_NOTE = 3,  // 1.0 => freeze on NoteOn / CC, 0.0 => ignore MIDI
  PORT_FFT_SIZE = 4,        // puissance de 2 (512, 1024, 2048)
  PORT_SPECTRAL_MODE = 5,   // 1.0 => mode spectral pur (magnitudes + phases synthétiques)
  PORT_FREEZE_CC_NUMBER = 6 // Port LV2 pour numéro CC déclencheur
} Ports;

// URIDs que l'on mappe au runtime
typedef struct {
  LV2_URID midi_MidiEvent;
  LV2_URID atom_Sequence;
} URIs;

typedef struct {
  // LV2
  const float* in_l;
  float* out_l;
  const LV2_Atom_Sequence* midi_in;
  const float* param_freeze_on_note; // bool (0/1)
  const float* param_fft_size;       // recommandé : 1024 par défaut
  const float* param_spectral_mode;  // bool (0/1)

  LV2_URID_Map* map;
  URIs uris;

  // État interne
  uint32_t srate;
  uint32_t fft_size;

  // Buffers time/freq
  double* time_buf;     // frame courant (taille fft_size)
  double* frozen_block; // bloc reconstruit par IFFT à boucler

  fftw_complex* spec;   // spectre temporaire
  fftw_plan plan_fwd;
  fftw_plan plan_inv;

  // Fenêtre Hann
  double* window;

  // Données pour mode spectral pur
  double* mags;         // magnitudes gelées (taille fft_size/2+1)
  double* phases;       // phases synthétiques (radians, taille fft_size/2+1)

  // Lecture en boucle du bloc gelé
  uint32_t play_pos;
  bool frozen;

  // CC Number to use
  const float* param_freeze_cc_number;

} FFTFreeze;

static void map_uris(FFTFreeze* self)
{
  self->uris.midi_MidiEvent = self->map->map(self->map->handle, LV2_MIDI__MidiEvent);
  self->uris.atom_Sequence  = self->map->map(self->map->handle, LV2_ATOM__Sequence);
}

static void make_window(FFTFreeze* self)
{
  for (uint32_t n = 0; n < self->fft_size; ++n) {
    self->window[n] = 0.5 - 0.5 * cos((2.0 * M_PI * n) / (double)(self->fft_size - 1));
  }
}

static void realloc_fft(FFTFreeze* self, uint32_t new_size)
{
  if (self->plan_fwd) fftw_destroy_plan(self->plan_fwd);
  if (self->plan_inv) fftw_destroy_plan(self->plan_inv);
  free(self->time_buf);
  free(self->frozen_block);
  free(self->window);
  free(self->mags);
  free(self->phases);
  fftw_free(self->spec);

  self->fft_size = new_size;

  self->time_buf     = (double*)calloc(self->fft_size, sizeof(double));
  self->frozen_block = (double*)calloc(self->fft_size, sizeof(double));
  self->window       = (double*)calloc(self->fft_size, sizeof(double));
  self->spec         = (fftw_complex*)fftw_malloc(sizeof(fftw_complex) * (self->fft_size/2 + 1));
  self->mags         = (double*)calloc(self->fft_size/2 + 1, sizeof(double));
  self->phases       = (double*)calloc(self->fft_size/2 + 1, sizeof(double));

  self->plan_fwd = fftw_plan_dft_r2c_1d((int)self->fft_size, self->time_buf, self->spec, FFTW_MEASURE);
  self->plan_inv = fftw_plan_dft_c2r_1d((int)self->fft_size, self->spec, self->frozen_block, FFTW_MEASURE);

  make_window(self);
  self->play_pos = 0;
}

static LV2_Handle instantiate(const LV2_Descriptor*     descriptor,
                              double                    rate,
                              const char*               bundle_path,
                              const LV2_Feature* const* features)
{
  FFTFreeze* self = (FFTFreeze*)calloc(1, sizeof(FFTFreeze));
  if (!self) return NULL;

  self->srate = (uint32_t)lrint(rate);

  // Récupération de l'URID map
  for (const LV2_Feature* const* f = features; f && *f; ++f) {
    if (!strcmp((*f)->URI, LV2_URID__map)) {
      self->map = (LV2_URID_Map*)(*f)->data;
    }
  }
  if (!self->map) {
    free(self);
    return NULL; // URID map obligatoire pour l'Atom/MIDI
  }

  map_uris(self);

  // FFT size par défaut
  realloc_fft(self, 1024);

  self->frozen = false;
  return (LV2_Handle)self;
}

static void connect_port(LV2_Handle instance, uint32_t port, void* data)
{
  FFTFreeze* self = (FFTFreeze*)instance;
  switch ((Ports)port) {
    case PORT_IN_L:            self->in_l  = (const float*)data; break;
    case PORT_OUT_L:           self->out_l = (float*)data; break;
    case PORT_MIDI_IN:         self->midi_in = (const LV2_Atom_Sequence*)data; break;
    case PORT_FREEZE_ON_NOTE:  self->param_freeze_on_note = (const float*)data; break;
    case PORT_FFT_SIZE:        self->param_fft_size = (const float*)data; break;
    case PORT_SPECTRAL_MODE:   self->param_spectral_mode = (const float*)data; break;
    default: break;
  }
}

static inline bool is_note_on(const uint8_t* const msg)
{
  const uint8_t st = msg[0] & 0xF0u;
  return (st == LV2_MIDI_MSG_NOTE_ON && msg[2] > 0);
}

static inline bool is_note_off(const uint8_t* const msg)
{
  const uint8_t st = msg[0] & 0xF0u;
  return (st == LV2_MIDI_MSG_NOTE_OFF) || (st == LV2_MIDI_MSG_NOTE_ON && msg[2] == 0);
}

static inline bool is_cc_freeze(const uint8_t* msg, uint8_t freeze_cc_number) {
    uint8_t status = msg[0] & 0xF0;
    if (status == 0xB0) { // CC
        uint8_t cc_num = msg[1];
        uint8_t cc_val = msg[2];
        if (cc_num == freeze_cc_number) {
            return (cc_val >= 64); // déclenche gel si CC >= 64
        }
    }
    return false;
}

static void handle_midi(FFTFreeze* self)
{
  if (!self->midi_in) return;
  uint8_t freeze_cc = self->param_freeze_cc_number ? (uint8_t)(*self->param_freeze_cc_number) : 20;

  LV2_ATOM_SEQUENCE_FOREACH(self->midi_in, ev) {
    if (ev->body.type == self->uris.midi_MidiEvent) {
      const uint8_t* const msg = (const uint8_t*)(ev + 1);
      if (*self->param_freeze_on_note >= 0.5f) {
        if (is_note_on(msg) || is_cc_freeze(msg, freeze_cc)) {
          // Capture du frame courant -> spectre (inchangé)
          for (uint32_t i = 0; i < self->fft_size; ++i) {
            const float x = self->in_l ? self->in_l[i] : 0.0f;
            self->time_buf[i] = (double)x * self->window[i];
          }
          fftw_execute(self->plan_fwd);

          const bool spectral = (self->param_spectral_mode && *self->param_spectral_mode >= 0.5f);
          if (spectral) {
            const uint32_t K = self->fft_size/2 + 1;
            for (uint32_t k = 0; k < K; ++k) {
              double re = self->spec[k][0];
              double im = self->spec[k][1];
              self->mags[k] = hypot(re, im);
              self->phases[k] = ((double)rand() / RAND_MAX) * 2.0 * M_PI;
              self->spec[k][0] = self->mags[k] * cos(self->phases[k]);
              self->spec[k][1] = self->mags[k] * sin(self->phases[k]);
            }
            fftw_execute(self->plan_inv);
            double invN = 1.0 / self->fft_size;
            for (uint32_t i = 0; i < self->fft_size; ++i) self->frozen_block[i] *= invN;
          } else {
            fftw_execute(self->plan_inv);
            double invN = 1.0 / self->fft_size;
            for (uint32_t i = 0; i < self->fft_size; ++i) self->frozen_block[i] *= invN;
          }

          self->play_pos = 0;
          self->frozen = true;
        } else if (is_note_off(msg)) {
          self->frozen = false;
        }
      }
    }
  }
}

static void run(LV2_Handle instance, uint32_t n_samples)
{
  FFTFreeze* self = (FFTFreeze*)instance;

  // Ajuster dynamiquement la taille FFT si demandé (arrondi puissance de 2 simplifié)
  if (self->param_fft_size) {
    uint32_t req = (uint32_t)lrintf(*self->param_fft_size);
    if (req != self->fft_size && req >= 256 && req <= 8192) {
      // Sécurité : bornes et plan de re-création
      realloc_fft(self, req);
    }
  }

  handle_midi(self);

  if (!self->in_l || !self->out_l) return;

  if (!self->frozen) {
    // Pas gelé : passthrough simple (mono)
    for (uint32_t i = 0; i < n_samples; ++i)
      self->out_l[i] = self->in_l[i];
  } else {
    // Gelé : lire en boucle dans frozen_block
    for (uint32_t i = 0; i < n_samples; ++i) {
      self->out_l[i] = (float)self->frozen_block[self->play_pos];
      self->play_pos++;
      if (self->play_pos >= self->fft_size)
        self->play_pos = 0;
    }
  }
}

static void cleanup(LV2_Handle instance)
{
  FFTFreeze* self = (FFTFreeze*)instance;
  if (!self) return;

  if (self->plan_fwd) fftw_destroy_plan(self->plan_fwd);
  if (self->plan_inv) fftw_destroy_plan(self->plan_inv);
  fftw_free(self->spec);
  free(self->time_buf);
  free(self->frozen_block);
  free(self->window);
  free(self->mags);
  free(self->phases);
  free(self);
}

static const void* extension_data(const char* uri) {
  (void)uri;
  return NULL;
}

static const LV2_Descriptor descriptor = {
  FFT_FREEZE_URI,
  instantiate,
  connect_port,
  NULL, // activate
  run,
  NULL, // deactivate
  cleanup,
  extension_data
};

LV2_SYMBOL_EXPORT
const LV2_Descriptor* lv2_descriptor(uint32_t index)
{
  return (index == 0) ? &descriptor : NULL;
}
